rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && incoming().name is string
        && incoming().name.size() <= 100;
      allow delete: if isOwner(userId);

      // User Food Logs Subcollection
      match /foodLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (incoming().food_name is string || incoming().meal_name is string)
          && incoming().calories is number;
        allow delete: if isOwner(userId);
      }

      // User Water Logs Subcollection
      match /waterLogs/{date} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (incoming().current_ml is number || incoming().amount_ml is number);
        allow delete: if isOwner(userId);
      }
    }
  }
}
